local function buatTombol(namaDisplay, scriptFungsi, warnaTombol)
    local Button = Instance.new("TextButton")
    Button.Parent = ScrollingFrame
    Button.BackgroundColor3 = warnaTombol or Color3.fromRGB(65, 65, 65)
    Button.Size = UDim2.new(1, 0, 0, 32)
    Button.Font = Enum.Font.SourceSansBold
    Button.Text = namaDisplay
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 14
    
    Button.MouseButton1Click:Connect(function() pcall(scriptFungsi) end)
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
    return Button
end

