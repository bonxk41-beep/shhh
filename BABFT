-- PART 3: MULTI-MODE MOVEMENT ENGINE (FLY & INSTANT TP)
-- =================================================================
_G.AutoFarmEmas = false
_G.ModePerpindahan = "Terbang" -- Pilihan awal: "Terbang" atau "Teleport"

local TweenService = game:GetService("TweenService")
local StatusTeks = nil

local function pindahKe(cframeTarget, kecepatanKustom)
    local player = game.Players.LocalPlayer
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    local rootPart = player.Character.HumanoidRootPart
    
    -- JIKA MEMILIH MODE TELEPORT INSTAN
    if _G.ModePerpindahan == "Teleport" then
        rootPart.CFrame = cframeTarget
        task.wait(0.1)
        return true
    end

    -- JIKA MEMILIH MODE TERBANG CEPAT (TWEEN FLY)
    local kecepatan = kecepatanKustom or 300
    local jarak = (rootPart.Position - cframeTarget.Position).Magnitude
    local durasi = jarak / kecepatan
    
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = rootPart
    
    local noclipLoop = game:GetService("RunService").Stepped:Connect(function()
        if player.Character then
            for _, child in pairs(player.Character:GetChildren()) do
                if child:IsA("BasePart") then child.CanCollide = false end
            end
        end
    end)
    
    local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = cframeTarget})
    tween:Play()
    
    local sukses = false
    tween.Completed:Connect(function() sukses = true end)
    
    while not sukses do
        task.wait(0.05)
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then break end
        if not _G.AutoFarmEmas and kecepatanKustom == nil then break end
        if sukses then break end
    end
    
    bv:Destroy()
    noclipLoop:Disconnect()
    return sukses
end

