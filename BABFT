-- 2. LOGIKA GENERATOR KEY ACAK HARIAN SECARA MATEMATIS
-- Menggunakan rumus matematika math.randomseed berdasarkan tanggal hari ini.
-- Hasilnya: Sepanjang hari ini Key-nya akan sama, tapi besok otomatis berubah total!
math.randomseed(tonumber(teksTanggal)) 
local function BuatKeyHarian()
    local karakter = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local hasilAcak = ""
    for i = 1, 5 do
        local randIndex = math.random(1, #karakter)
        hasilAcak = hasilAcak .. string.sub(karakter, randIndex, randIndex)
    end
    return "NZM-KEY-" .. hasilAcak
end

