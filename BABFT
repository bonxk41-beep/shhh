-- 2. GENERATOR KEY ACAK HARIAN (Format: NZM-KEY-XXXXX)
local function BuatKeyHarian(seedStr)
    local seed = tonumber(seedStr) or 12345
    local karakter = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local hasilAcak = ""
    
    for i = 1, 5 do
        seed = (seed * 9301 + 49297) % 233280
        local index = math.floor((seed / 233280) * #karakter) + 1
        hasilAcak = hasilAcak .. string.sub(karakter, index, index)
    end
    return "NZM-KEY-" .. hasilAcak
end

